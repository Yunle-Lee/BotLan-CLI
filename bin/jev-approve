#!/usr/bin/env python3
"""jev-approve - ask the Spark Duo daemon whether a tool call may run.

Ported from proxysoul/Empryo src/hearth/approve-cli.ts, including its exit conventions, which are what
makes it usable as a Claude-Code-style PreToolUse hook:

    0  allow (or no opinion)
    2  block - stderr becomes the denial reason
   >0  non-blocking error (the agent continues, the warning is logged)

Modes:
    jev-approve approve  < hook.json     wait for a decision and report it
    jev-approve status                   list what is waiting for an answer
    jev-approve allow <id> | deny <id>   resolve one pending approval from a terminal

A wedged daemon must not brick a local session, so approve fails closed (deny) and status fails soft
(prints nothing, exits 0).
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from agent.protocol import ProtocolError, socket_request

SOCKET = os.environ.get("JEV_APPROVE_SOCKET", "~/.spark-duo/approvals.sock")
TIMEOUT_MS = int(os.environ.get("JEV_APPROVE_TIMEOUT_MS", "300000"))


def main(argv=None) -> int:
    args = list(argv if argv is not None else sys.argv[1:])
    mode = args[0] if args else "approve"
    path = os.path.expanduser(SOCKET)

    try:
        if mode == "status":
            res = socket_request(path, {"op": "status"}, timeout_ms=5000)
            for item in res.get("pending", []):
                print(f"{item['id'][:8]}  {item['tool_name']:12} {item['summary']}")
            print(f"({res.get('count', 0)} pending)")
            return 0

        if mode in ("allow", "deny"):
            if len(args) < 2:
                print(f"usage: jev-approve {mode} <approval-id>", file=sys.stderr)
                return 1
            res = socket_request(path, {"op": "resolve", "id": args[1], "decision": mode,
                                        "remember": args[2] if len(args) > 2 else None},
                                 timeout_ms=5000)
            print(f"{res.get('decision', 'unknown')} {res.get('reason') or ''}".strip())
            return 0 if res.get("resolved") else 1

        # approve: read the hook payload from stdin (empty stdin is fine, the daemon has the call)
        hook = {}
        if not sys.stdin.isatty():
            raw = sys.stdin.read().strip()
            if raw:
                try:
                    hook = json.loads(raw)
                except json.JSONDecodeError:
                    hook = {"tool_name": raw[:64]}
        req = {"op": "approve",
               "session_id": str(hook.get("session_id") or "cli"),
               "tool_name": str(hook.get("tool_name") or ""),
               "tool_call_id": str(hook.get("tool_use_id") or ""),
               "cwd": str(hook.get("cwd") or os.getcwd()),
               "tool_input": hook.get("tool_input") or {}}
        res = socket_request(path, req, timeout_ms=TIMEOUT_MS)
        if res.get("decision") == "allow":
            print(res.get("reason") or "allowed")
            return 0
        print(res.get("reason") or "denied", file=sys.stderr)
        return 2
    except ProtocolError as exc:
        if mode == "status":
            return 0
        print(f"no daemon ({exc}) - failing closed", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
